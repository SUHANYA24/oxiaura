# Copy to .env and fill in real values. Never commit .env.

# --- Flask ---
FLASK_APP=wsgi.py
APP_ENV=development

# --- Secrets (generate strong random values, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`) ---
SECRET_KEY=
JWT_SECRET_KEY=
# Signs agreement QR authenticity tokens (Phase 8). Defaults to SECRET_KEY if unset.
QR_SECRET_KEY=

# --- Database (MySQL 8) ---
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/plantvest
# Optional isolated DB for the test suite (defaults to in-memory SQLite)
TEST_DATABASE_URL=

# --- Redis (Celery broker + result backend, Phase 7) ---
REDIS_URL=redis://localhost:6379/0
# No Redis on this machine? Set CELERY_EAGER=1 and OCR + fraud run inside the
# upload request instead of on a worker — no redis-server, no celery worker.
# Without it, uploads fail with "Error 10061 connecting to localhost:6379".
# The trade-off: the request blocks for the whole pipeline (seconds to tens of
# seconds on the first upload, while EasyOCR loads). Ignored in production.
CELERY_EAGER=

# --- File uploads (used from Phase 5) ---
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=10

# --- Generated agreement PDFs (Phase 8) ---
AGREEMENTS_FOLDER=agreements

# --- Fraud detection (Phase 6) ---
# Aggregate score (0-100) above which a document is flagged. 60 was chosen while
# both model detectors returned mock scores spread around 50. Against the trained
# CNN the distribution sits lower: ml_training.evaluate_pipeline measures recall
# 0.244 / precision 0.984 at 60, and best accuracy at ~43. Re-check it for your
# own documents before trusting it, and pick your own precision/recall balance.
FRAUD_FLAG_THRESHOLD=60
# Paths to trained model weights. Leave blank to use deterministic mock scores.
FRAUD_CNN_WEIGHTS=ml_training/saved_models/cnn_tamper.pt
FRAUD_SIAMESE_WEIGHTS=ml_training/saved_models/siamese_embedder.pt
# Known-forgery embedding bank (ml_training.build_reference_bank). The Siamese
# detector needs this AND its weights to score for real — weights alone give it
# nothing to compare an upload against, so it keeps returning a mock.
FRAUD_REFERENCE_BANK=NDB

# --- CORS (locked to the frontend origin in Phase 11) ---
CORS_ORIGINS=*
